{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.example.org/mnaa/0.1/schemas/readiness-request.schema.json",
  "title": "MNAA readiness request",
  "type": "object",
  "required": ["$schema", "spec_version", "admission_id", "resource", "environment", "capability"],
  "properties": {
    "$schema": { "const": "https://spec.example.org/mnaa/0.1/schemas/readiness-request.schema.json" },
    "spec_version": { "const": "0.1" },
    "admission_id": { "type": "string", "format": "uri" },
    "resource": { "type": "string", "format": "uri", "pattern": "^https://" },
    "environment": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
    "capability": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$" },
    "provisioning_reference": { "type": "string", "format": "uri" },
    "client_id": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
